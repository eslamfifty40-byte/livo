rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'livo.admin@gmail.com' ||
        request.auth.token.email == 'eslamfifty11@gmail.com' ||
        request.auth.token.role == 'owner'
      );
    }

    function isAdminOrSupervisor() {
      return isOwner() || (isAuthenticated() && request.auth.token.role == 'supervisor');
    }

    function validRole(role) {
      return role in ['owner', 'supervisor', 'agent', 'charging_agent', 'distributor_agent', 'user'];
    }

    function adminCosmeticKeys() {
      return [
        'verifiedBadgeColor',
        'verifiedBadgeShape',
        'verifiedBadgeGlow',
        'nameGlowColor',
        'customIconUrl',
        'customIconLabel',
        'customIconGlow',
        'customIconAnimated',
        'frameGlowColor',
        'frameAnimated',
        'equippedFrameUrl'
      ];
    }

    // Users Collection (keyed by 5-digit LIVO UID, bound via authUid == request.auth.uid)
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner() || (
        isAuthenticated() &&
        request.resource.data.uid is string &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.role == 'user' &&
        request.resource.data.coins == 0 &&
        request.resource.data.isVerified == false &&
        !request.resource.data.keys().hasAny(adminCosmeticKeys())
      );

      allow update: if isOwner() || (
        isAuthenticated() &&
        validRole(request.resource.data.role) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isVerified == resource.data.isVerified &&
        request.resource.data.coins is number &&
        request.resource.data.coins >= 0 &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminCosmeticKeys())
      );

      allow delete: if isOwner();
    }

    // Direct Private Messages (bound via senderAuthUid / receiverAuthUid)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        isOwner() ||
        resource.data.senderAuthUid == request.auth.uid ||
        resource.data.receiverAuthUid == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );

      allow create: if isAuthenticated() &&
        request.resource.data.senderUid is string &&
        request.resource.data.receiverUid is string &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 4000 &&
        (
          isOwner() ||
          request.resource.data.senderAuthUid == request.auth.uid ||
          request.resource.data.senderUid == request.auth.uid
        );

      allow update: if isAuthenticated() && (
        isOwner() ||
        resource.data.receiverAuthUid == request.auth.uid ||
        resource.data.senderAuthUid == request.auth.uid
      );

      allow delete: if isOwner() || (
        isAuthenticated() &&
        resource.data.senderAuthUid == request.auth.uid
      );
    }

    // Message Requests (pending / accepted / rejected / suspended)
    match /message_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isOwner() ||
        resource.data.senderAuthUid == request.auth.uid ||
        resource.data.receiverAuthUid == request.auth.uid
      );

      allow create: if isAuthenticated() &&
        request.resource.data.senderUid is string &&
        request.resource.data.receiverUid is string &&
        request.resource.data.introMessage is string &&
        request.resource.data.introMessage.size() <= 1000 &&
        request.resource.data.status in ['pending', 'accepted', 'rejected', 'suspended'] &&
        (
          isOwner() ||
          request.resource.data.senderAuthUid == request.auth.uid
        );

      allow update: if isAuthenticated() &&
        request.resource.data.status in ['pending', 'accepted', 'rejected', 'suspended'] &&
        (
          isOwner() ||
          resource.data.senderAuthUid == request.auth.uid ||
          resource.data.receiverAuthUid == request.auth.uid
        );

      allow delete: if isOwner();
    }

    // Voice Rooms & Official Room
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isOwner() || (
        isAuthenticated() &&
        resource.data.isOfficial == false
      );
    }

    // Recharge Requests Collection
    match /recharge_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.receiptUrl is string;
      allow update: if isAdminOrSupervisor();
      allow delete: if false;
    }

    // Financial Audit Logs
    match /coin_audits/{auditId} {
      allow read: if isAdminOrSupervisor() || isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Ban Records
    match /bans/{banId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrSupervisor() || isOwner();
      allow delete: if false;
    }

    // Agency Applications
    match /agencies/{agencyId} {
      allow read, create: if isAuthenticated();
      allow update: if isAdminOrSupervisor() || isAuthenticated();
      allow delete: if isOwner();
    }

    // Blue Verification Requests
    match /verifications/{verId} {
      allow read, create: if isAuthenticated();
      allow update: if isAdminOrSupervisor() || isOwner();
      allow delete: if isOwner();
    }

    // Withdrawal Requests
    match /withdrawals/{wthId} {
      allow read, create: if isAuthenticated();
      allow update: if isAdminOrSupervisor() || isOwner();
      allow delete: if false;
    }

    // Advertisements Collection
    match /advertisements/{adId} {
      allow read: if true;
      allow create, delete: if isAdminOrSupervisor();
      allow update: if isAuthenticated();
    }

    // Central Support Tickets
    match /support_tickets/{ticketId} {
      allow read, create: if isAuthenticated();
      allow update: if isAdminOrSupervisor() || isOwner();
      allow delete: if isOwner();
    }

    // Payment Methods Collection
    match /payment_methods/{methodId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSupervisor();
    }

    // Animated Gifts Collection
    match /gifts/{giftId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSupervisor();
    }

    // Store Items Collection
    match /store_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSupervisor();
    }

    // Recharge Voucher Codes
    match /recharge_codes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdminOrSupervisor();
      allow update: if isAuthenticated();
    }

    // Coin Packages
    match /coin_packages/{pkgId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSupervisor();
    }

    // Supervisors Management
    match /supervisors/{supId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner();
    }

    // Genuine User Videos
    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Level Configs & Promotions
    match /level_configs/{levelId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSupervisor();
    }

    match /level_promotions/{promoId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwner();
    }

    // Distributors & Agent Transfers
    match /distributors/{distId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /agent_transfers/{transferId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Connection health check doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
